+package com.recom3.snow3.vision;
+import android.content.Intent;
+import android.net.Uri;
+/** Exact, deliberately small public launch surface. Opening Snow3 alone never takes a photo. */
+final class CaptureLaunch {
+    static final String URI="recom3://vision/capture";
+    static final String ACTION="com.recom3.vision.CAPTURE";
+    static boolean matches(Intent intent){
+        if(intent==null||!Intent.ACTION_VIEW.equals(intent.getAction()))return false;
+        Uri uri=intent.getData();
+        if(uri!=null)return URI.equals(uri.toString());
+        return "jet_camera".equals(intent.getStringExtra("feature"));
+    }
+}
