+++ b/app/src/main/java/com/recom3/visionprotocol/ReconFrameDecoder.java
@@ -0,0 +1,30 @@
+package com.recom3.visionprotocol;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+
+/** One instance per RFCOMM channel. Handles split headers and coalesced frames. */
+public final class ReconFrameDecoder {
+    public interface Listener { void frame(byte[] bytes) throws IOException; }
+    private final byte[] header=new byte[4];
+    private int headerUsed, used;
+    private byte[] current;
+    public void reset() { current=null; headerUsed=0; used=0; }
+    public void feed(byte[] bytes, int count, Listener listener) throws IOException {
+        if(count<0 || count>bytes.length) throw new IOException("Invalid read size");
+        int p=0;
+        while(p<count) {
+            if(current==null) {
+                int n=Math.min(4-headerUsed,count-p);
+                System.arraycopy(bytes,p,header,headerUsed,n); headerUsed+=n; p+=n;
+                if(headerUsed<4) continue;
+                int length=ByteBuffer.wrap(header).getInt();
+                if(length<20 || length>ReconMessage.MAX_FRAME) {reset(); throw new IOException("Invalid Recon frame length");}
+                current=new byte[length]; System.arraycopy(header,0,current,0,4); used=4;
+            }
+            int n=Math.min(current.length-used,count-p);
+            System.arraycopy(bytes,p,current,used,n); p+=n; used+=n;
+            if(used==current.length) { byte[] result=current; reset(); listener.frame(result); }
+        }
+    }
+}
diff --git a/app/src/main/java/com/recom3/visionprotocol/ReconMessage.java b/app/src/main/java/com/recom3/visionprotocol/ReconMessage.java
