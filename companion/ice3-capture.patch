+        TextView title=new TextView(this);title.setText("Snow3 · Jet Vision prototype");title.setTextSize(23);root.addView(title);
+        TextView note=new TextView(this);note.setText("Select on the Jet sends one photograph through Recon Bluetooth FILE for cloud analysis. Local configuration chooses OpenAI or Gemini. Images are processed in memory; API keys are never included in the APK.");root.addView(note);
+        button(root,"Open ICE3 Capture",new View.OnClickListener(){public void onClick(View v){startActivity(new Intent(VisionActivity.this,com.recom3.snow3.capture.CaptureActivity.class));}});config=new TextView(this);root.addView(config);
+        peers=new Spinner(this);root.addView(peers);
+        button(root,"Refresh paired devices",new View.OnClickListener(){public void onClick(View v){refresh();}});
+        button(root,"Connect paired Jet",new View.OnClickListener(){public void onClick(View v){connect();}});
+        button(root,"Reload local configuration",new View.OnClickListener(){public void onClick(View v){controller.reload();config.setText(controller.configurationSummary());}});
+        button(root,"Cancel current request",new View.OnClickListener(){public void onClick(View v){controller.cancel(-1);}});
+        button(root,"Disable Vision",new View.OnClickListener(){public void onClick(View v){controller.disable();config.setText(controller.configurationSummary());}});
+        button(root,"Stop Vision session",new View.OnClickListener(){public void onClick(View v){stopService(new Intent(VisionActivity.this,VisionSessionService.class));controller.disable();config.setText(controller.configurationSummary());}});
+        button(root,"Delete private API configuration",new View.OnClickListener(){public void onClick(View v){controller.clear();config.setText(controller.configurationSummary());}});
+        state=new TextView(this);root.addView(state);
+        ScrollView scroll=new ScrollView(this);scroll.addView(root);setContentView(scroll);
+        config.setText(controller.configurationSummary());refresh();
+        Intent session=new Intent(this,VisionSessionService.class);
+        if(Build.VERSION.SDK_INT>=26)startForegroundService(session);else startService(session);
+        bound=bindService(new Intent(this,EngageHudConnectivityService.class),connection,Context.BIND_AUTO_CREATE);
+    }
+    private void button(LinearLayout p,String text,View.OnClickListener click){Button b=new Button(this);b.setText(text);b.setOnClickListener(click);p.addView(b);}
+    private void refresh(){
+        devices.clear();List<String> labels=new ArrayList<String>();
+        try{BluetoothAdapter a=BluetoothAdapter.getDefaultAdapter();if(a==null||!a.isEnabled()){state.setText("Enable Bluetooth in system Settings first.");return;}
+            for(BluetoothDevice d:a.getBondedDevices()){devices.add(d);labels.add(d.getName()+" · "+d.getAddress());}
+        }catch(SecurityException e){state.setText("Bluetooth permission is required in system Settings.");return;}
+        peers.setAdapter(new ArrayAdapter<String>(this,android.R.layout.simple_spinner_dropdown_item,labels));
+        if(devices.isEmpty())state.setText("Pair the Jet in system Bluetooth settings, then refresh.");
+    }
+    private void connect(){if(service==null||devices.isEmpty()){state.setText("Pair the Jet and wait for Snow3 service first.");return;}
+        try{service.connect(HUDConnectivityService.DeviceType.ANDROID,devices.get(peers.getSelectedItemPosition()).getAddress());state.setText("Connecting Recon COMMAND, OBJECT and FILE channels…");}
+        catch(SecurityException e){state.setText("Allow Bluetooth permission in phone Settings.");}
+    }
+    @Override protected void onResume(){super.onResume();controller.observe(this);}
+    @Override protected void onPause(){controller.observe(null);super.onPause();}
+    @Override protected void onDestroy(){if(bound)unbindService(connection);super.onDestroy();}
+    public void status(String text){state.setText(text);}
+}
