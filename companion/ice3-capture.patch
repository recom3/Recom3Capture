+package com.recom3.snow3.capture;
+
+import android.graphics.Bitmap;
+import android.media.*;
+import java.io.*;
+import java.nio.ByteBuffer;
+
+/** Phone-side silent H.264/MP4 encoder. All calls belong to the capture worker. */
+final class PhoneVideo {
+    private MediaCodec codec;private MediaMuxer muxer;private int track=-1,width,height,color;
+    private boolean muxing;private long firstNs;private final File pending,complete;
+    PhoneVideo(File folder,Bitmap first) throws Exception {
+        width=first.getWidth()&~1;height=first.getHeight()&~1;
+        complete=new File(folder,"capture-"+System.currentTimeMillis()+".mp4");pending=new File(complete.getPath()+".partial");
+        try {
+            codec=MediaCodec.createEncoderByType("video/avc");
+            int[] formats=codec.getCodecInfo().getCapabilitiesForType("video/avc").colorFormats;
+            for(int f:formats)if(f==MediaCodecInfo.CodecCapabilities.COLOR_FormatYUV420Planar){color=f;break;}
