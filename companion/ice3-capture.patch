@@ -0,0 +1,22 @@
+"""Provision ignored local config to debug Snow3 private storage without printing secrets."""
+import argparse
+import pathlib
+import subprocess
+import sys
+
+parser=argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--adb',required=True)
+parser.add_argument('--serial',required=True)
+parser.add_argument('--config',default=str(pathlib.Path(__file__).resolve().parents[1]/'vision.local.properties'))
+args=parser.parse_args()
+try:
+    config=pathlib.Path(args.config).read_bytes()
+    if len(config)>16384: raise ValueError('Configuration exceeds limit')
+    # Do not put secret contents in command-line arguments, temporary device shared storage or logs.
+    command=[args.adb,'-s',args.serial,'shell']
+    subprocess.run(command+['run-as com.recom3.snow3 mkdir -p files'],check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+    subprocess.run(command+["run-as com.recom3.snow3 sh -c 'umask 077; cat > files/vision.properties'"],input=config,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
+    print('Vision configuration provisioned to Snow3 app-private storage. No key packaged in APK.')
+except Exception:
+    print('Provisioning failed. Check the local file, selected serial, debug APK and ADB authorization.',file=sys.stderr)
+    sys.exit(1)
