+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=27,constants=BuildConfig.class,application=Application.class,manifest=Config.NONE)
+public class OpenAiVisionClientTest {
+    private static final String ANSWER="Synthetic response fixture, not a real photograph description.";
+    private static class Fake extends HttpsURLConnection {
+        int status=200;int posts;boolean disconnected;ByteArrayOutputStream body=new ByteArrayOutputStream();
+        Fake()throws Exception{super(new URL("https://api.openai.com/v1/responses"));}
+        public String getCipherSuite(){return "test";}
+        public Certificate[] getLocalCertificates(){return null;}
+        public Certificate[] getServerCertificates(){return null;}
+        public Principal getPeerPrincipal(){return null;}
+        public Principal getLocalPrincipal(){return null;}
+        public void disconnect(){disconnected=true;}
+        public boolean usingProxy(){return false;}
+        public void connect(){}
+        public OutputStream getOutputStream(){posts++;return body;}
+        public int getResponseCode(){return status;}
+        public InputStream getInputStream()throws IOException{
+            try{return new ByteArrayInputStream(response(ANSWER).toString().getBytes("UTF-8"));}catch(Exception e){throw new IOException("Fixture failure");}
+        }
+    }
+    private static JSONObject response(String text)throws Exception{
+        return new JSONObject().put("status","completed").put("output",new JSONArray().put(new JSONObject().put("type","message").put("role","assistant").put("content",new JSONArray().put(new JSONObject().put("type","output_text").put("text",text)))));
+    }
+    @Test public void sendsExactJpegOnceAndDoesNotStoreResponse()throws Exception{
+        final Fake fake=new Fake();final int[] calls={0};
+        OpenAiVisionClient client=new OpenAiVisionClient(new OpenAiVisionClient.Connections(){public HttpsURLConnection open(URL url){calls[0]++;assertEquals("https://api.openai.com/v1/responses",url.toString());return fake;}});
+        byte[] jpeg={(byte)255,(byte)216,12,34,(byte)255,(byte)217};
+        assertEquals(ANSWER,client.describe(jpeg,"synthetic-unit-test-credential","gpt-4.1-mini"));
+        JSONObject json=new JSONObject(new String(fake.body.toByteArray(),"UTF-8"));
+        assertEquals("gpt-4.1-mini",json.getString("model"));assertFalse(json.getBoolean("store"));assertEquals(180,json.getInt("max_output_tokens"));
+        JSONArray content=json.getJSONArray("input").getJSONObject(0).getJSONArray("content");
+        assertEquals("input_image",content.getJSONObject(1).getString("type"));
+        assertArrayEquals(jpeg,Base64.decode(content.getJSONObject(1).getString("image_url").substring("data:image/jpeg;base64,".length()),Base64.DEFAULT));
+        assertEquals(1,calls[0]);assertEquals(1,fake.posts);assertTrue(fake.disconnected);assertFalse(fake.getInstanceFollowRedirects());
+    }
+    @Test public void authErrorDoesNotRetryOrEchoCredential()throws Exception{
+        final Fake fake=new Fake();fake.status=401;
+        OpenAiVisionClient client=new OpenAiVisionClient(new OpenAiVisionClient.Connections(){public HttpsURLConnection open(URL u){return fake;}});
+        try{client.describe(new byte[]{1},"synthetic-private-value","gpt-4.1-mini");fail();}catch(IOException e){assertFalse(e.getMessage().contains("synthetic-private-value"));assertTrue(e.getMessage().contains("401"));}
+        assertEquals(1,fake.posts);
+    }
+    @Test public void cancelledRequestNeverOpensNetwork()throws Exception{
+        final int[] calls={0};OpenAiVisionClient client=new OpenAiVisionClient(new OpenAiVisionClient.Connections(){public HttpsURLConnection open(URL u)throws IOException{calls[0]++;throw new IOException("Must not open");}});
+        client.cancel();try{client.describe(new byte[]{1},"synthetic","gpt-4.1-mini");fail();}catch(IOException expected){}
+        assertEquals(0,calls[0]);
+    }
+    @Test public void refusesIncompleteOrNonTextOutput()throws Exception{
