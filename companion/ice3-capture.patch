+package com.recom3.snow3.vision;
+import android.app.Activity;
+import android.content.*;
+import android.os.*;
+import android.util.Log;
+import android.view.WindowManager;
+import android.widget.*;
+import com.recom3.snow3.hudconnectivity.HUDConnectivityMessage;
+import com.recom3.snow3.mobilesdk.HUDConnectivityService;
+import com.recom3.snow3.mobilesdk.hudconnectivity.HUDStateUpdateListener;
+import com.recom3.jetandroid.services.EngageHudConnectivityService;
+import java.util.UUID;
+
+/** App Actions/deep-link fulfillment only. The existing FILE and cloud pipeline is unchanged. */
+public final class VisionCaptureActivity extends Activity {
+    private final Handler ui=new Handler();
+    private HUDConnectivityService service;
+    private boolean bound,handled;
+    private TextView state;
+    private static long lastSent;
+    private final ServiceConnection connection=new ServiceConnection(){
+        public void onServiceConnected(ComponentName n,IBinder b){service=((HUDConnectivityService.LocalBinder)b).getService();dispatch();}
+        public void onServiceDisconnected(ComponentName n){service=null;}
+    };
+    public void onCreate(Bundle saved){
+        super.onCreate(saved);getWindow().addFlags(WindowManager.LayoutParams.FLAG_SECURE);
+        LinearLayout root=new LinearLayout(this);root.setPadding(24,24,24,24);root.setOrientation(1);
+        state=new TextView(this);state.setTextSize(20);root.addView(state);
+        Button open=new Button(this);open.setText("Open Snow3 Vision");root.addView(open);
+        open.setOnClickListener(new android.view.View.OnClickListener(){public void onClick(android.view.View v){startActivity(new Intent(VisionCaptureActivity.this,VisionActivity.class));finish();}});
+        setContentView(root);
+        if(saved!=null){handled=true;state.setText("Capture launch already handled. Use Select on the Jet or launch Capture again.");return;}
+        if(!CaptureLaunch.matches(getIntent())){handled=true;state.setText("Unknown Vision action. No photograph taken.");Log.i("Snow3VisionLaunch","rejectedInvalidIntent");return;}
+        state.setText("Requesting one photograph from the connected Jet…");
+        bound=bindService(new Intent(this,EngageHudConnectivityService.class),connection,Context.BIND_AUTO_CREATE);
+        ui.postDelayed(new Runnable(){public void run(){if(!handled){handled=true;state.setText("Snow3 Bluetooth service unavailable. Open Snow3 Vision and connect the Jet, then try again.");Log.i("Snow3VisionLaunch","serviceTimeout");}}},5000);
+    }
+    private void dispatch(){
+        if(handled)return;handled=true;
+        if(service.getConnectionState()!=HUDStateUpdateListener.HUD_STATE.CONNECTED){state.setText("Jet is not connected. Open Snow3 Vision, connect your paired Jet, then try again. No capture was queued.");Log.i("Snow3VisionLaunch","notConnected");return;}
+        long now=SystemClock.elapsedRealtime();
+        if(lastSent!=0&&now-lastSent<10000){state.setText("A capture was just requested. Wait for the Jet result before trying again.");Log.i("Snow3VisionLaunch","rateLimited");return;}
+        try{
+            Intent session=new Intent(this,VisionSessionService.class);
+            if(Build.VERSION.SDK_INT>=26)startForegroundService(session);else startService(session);
+            VisionController.get(this).attach(service);
+            String token=UUID.randomUUID().toString();
+            HUDConnectivityMessage message=new HUDConnectivityMessage((int)(now&0x7fffffff),CaptureLaunch.ACTION,"com.recom3.snow3.vision","",token.getBytes("UTF-8"));
+            service.push(message,HUDConnectivityService.Channel.OBJECT_CHANNEL);lastSent=now;
+            state.setText("Capture command sent over Recon Bluetooth OBJECT. Check the Jet for progress and spoken result. This screen does not confirm delivery.");
+            Log.i("Snow3VisionLaunch","captureCommandSent token="+token);
+        }catch(Exception e){state.setText("Capture command could not be sent. Open Snow3 Vision and retry.");Log.w("Snow3VisionLaunch","sendFailed="+e.getClass().getSimpleName());}
+    }
+    @Override protected void onStop(){handled=true;super.onStop();}
+    @Override protected void onDestroy(){ui.removeCallbacksAndMessages(null);if(bound)unbindService(connection);super.onDestroy();}
+}
