@@ -0,0 +1,67 @@
+package com.recom3.visionprotocol;
+
+import java.io.*;
+import java.nio.ByteBuffer;
+import java.security.MessageDigest;
+import java.util.zip.*;
+
+/** Original Recon big-endian envelope; no new wire framing. */
+public final class ReconMessage {
+    public static final String PHOTO = "com.recom3.vision.PHOTO";
+    public static final String RESULT = "com.recom3.vision.RESULT";
+    public static final String CANCEL = "com.recom3.vision.CANCEL";
+    public static final int MAX_JPEG = 1024 * 1024;
+    public static final int MAX_FRAME = 2 * 1024 * 1024;
+    public final int request;
+    public final String sender, action, info;
+    public final byte[] data;
+
+    public ReconMessage(int request, String sender, String action, String info, byte[] data) {
+        this.request=request; this.sender=sender; this.action=action; this.info=info; this.data=data;
+    }
+    public byte[] encode() throws IOException {
+        byte[] s=sender.getBytes("UTF-8"), a=action.getBytes("UTF-8"), i=info.getBytes("UTF-8");
+        int length=20+s.length+a.length+i.length+data.length;
+        if(length>MAX_FRAME) throw new IOException("Frame too large");
+        ByteBuffer b=ByteBuffer.allocate(length);
+        b.putInt(length).putInt(request); put(b,s); put(b,a); put(b,i); b.put(data);
+        return b.array();
+    }
+    private static void put(ByteBuffer b, byte[] v) { b.putInt(v.length).put(v); }
+    private static String string(ByteBuffer b) throws IOException {
+        if(b.remaining()<4) throw new IOException("Truncated string length");
+        int n=b.getInt();
+        if(n<0 || n>8192 || n>b.remaining()) throw new IOException("Invalid string length");
+        byte[] v=new byte[n]; b.get(v); return new String(v,"UTF-8");
+    }
+    public static ReconMessage decode(byte[] bytes) throws IOException {
+        if(bytes==null || bytes.length<20 || bytes.length>MAX_FRAME) throw new IOException("Invalid frame");
+        ByteBuffer b=ByteBuffer.wrap(bytes);
+        if(b.getInt()!=bytes.length) throw new IOException("Frame length mismatch");
+        int request=b.getInt();
+        String sender=string(b), action=string(b), info=string(b);
+        byte[] data=new byte[b.remaining()]; b.get(data);
+        return new ReconMessage(request,sender,action,info,data);
+    }
+    public static byte[] gzip(byte[] bytes) throws IOException {
+        ByteArrayOutputStream out=new ByteArrayOutputStream();
+        GZIPOutputStream zip=new GZIPOutputStream(out); zip.write(bytes); zip.close(); return out.toByteArray();
+    }
+    public static byte[] gunzip(byte[] bytes, int max) throws IOException {
+        return readBounded(new GZIPInputStream(new ByteArrayInputStream(bytes)),max);
+    }
+    public static byte[] readBounded(InputStream in, int max) throws IOException {
+        try {
+            ByteArrayOutputStream out=new ByteArrayOutputStream(); byte[] buf=new byte[8192]; int n;
+            while((n=in.read(buf))!=-1) { if(out.size()>max-n) throw new IOException("Size limit exceeded"); out.write(buf,0,n); }
+            return out.toByteArray();
+        } finally { in.close(); }
+    }
+    public static String sha256(byte[] bytes) throws IOException {
+        try {
+            byte[] hash=MessageDigest.getInstance("SHA-256").digest(bytes); StringBuilder s=new StringBuilder();
+            for(byte v:hash) { int n=v&255; if(n<16)s.append('0'); s.append(Integer.toHexString(n)); }
+            return s.toString();
+        } catch(Exception e) { throw new IOException("SHA-256 unavailable"); }
+    }
+}
