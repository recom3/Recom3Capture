+package com.recom3.snow3.vision;
+import java.util.LinkedHashSet;
+/** Suppress duplicated FILE delivery, including late duplicates after another capture. */
+final class CaptureRequests {
+    private final LinkedHashSet<String> seen=new LinkedHashSet<String>();
+    private final LinkedHashSet<Integer> cancelled=new LinkedHashSet<Integer>();
+    synchronized void cancel(int request){cancelled.add(request);if(cancelled.size()>128)cancelled.remove(cancelled.iterator().next());}
+    synchronized boolean isCancelled(int request){return cancelled.contains(request);}
+    synchronized boolean contains(int request,String hash){return seen.contains(request+":"+hash);}
+    synchronized void remember(int request,String hash){seen.add(request+":"+hash);if(seen.size()>128)seen.remove(seen.iterator().next());}
+}
