@@ -0,0 +1,23 @@
+package com.recom3.snow3.vision;
+import android.content.Context;
+import java.io.*;
+import java.util.Properties;
+/** Provisioned separately, in app-private storage, never BuildConfig or an APK asset. */
+final class VisionConfig {
+    static final String FILE="vision.properties";
+    final String provider,model,key;
+    final boolean enabled;
+    private VisionConfig(String p,String m,String k,boolean e){provider=p;model=m;key=k;enabled=e;}
+    static VisionConfig load(Context context)throws IOException{
+        Properties props=new Properties();File file=new File(context.getFilesDir(),FILE);
+        if(file.isFile()){
+            if(file.length()>16384)throw new IOException("Vision configuration too large");
+            InputStream in=new FileInputStream(file);try{props.load(in);}finally{in.close();}
+        }
+        String p=props.getProperty("vision.provider","openai").trim();
+        if(!"openai".equals(p)&&!"gemini".equals(p))throw new IOException("Unsupported vision provider");
+        return new VisionConfig(p,props.getProperty(p+".model","openai".equals(p)?"gpt-4.1-mini":"gemini-3.5-flash-lite").trim(),
+            props.getProperty(p+".api.key","").trim(),Boolean.parseBoolean(props.getProperty("vision.enabled","false")));
+    }
+    VisionProvider create(){return "gemini".equals(provider)?new GeminiVisionClient():new OpenAiVisionClient();}
+}
diff --git a/app/src/main/java/com/recom3/snow3/vision/VisionController.java b/app/src/main/java/com/recom3/snow3/vision/VisionController.java
new file mode 100644
index 0000000..ae1c64d
--- /dev/null
+++ b/app/src/main/java/com/recom3/snow3/vision/VisionController.java
@@ -0,0 +1,107 @@
+package com.recom3.snow3.vision;
+
+import android.content.*;
+import android.graphics.BitmapFactory;
+import android.os.*;
+import android.util.Log;
+import com.recom3.snow3.hudconnectivity.HUDConnectivityMessage;
+import com.recom3.snow3.mobilesdk.HUDConnectivityService;
+import com.recom3.visionprotocol.ReconMessage;
+import org.json.JSONObject;
+import java.io.*;
+import java.util.concurrent.*;
+
+/** Opt-in, one in-flight capture. Images stay in memory; keys are in private local config. */
+public final class VisionController {
+    private static VisionController singleton;
+    public static synchronized VisionController get(Context c){if(singleton==null)singleton=new VisionController(c.getApplicationContext());return singleton;}
+    public interface Listener{void status(String text);}
+    private final Handler ui=new Handler(Looper.getMainLooper());
+    private final ExecutorService worker=Executors.newSingleThreadExecutor();
+    private volatile HUDConnectivityService service;
+    private final Context context;
+    private volatile VisionConfig config;
+    private volatile boolean enabled;
+    private volatile Listener listener;
+    private volatile String state="Configure local API access, pair and connect the Jet.";
+    private Work active;
+    private final CaptureRequests requests=new CaptureRequests();
+    private static final class Work{
+        final int request;final String hash;final long start=SystemClock.elapsedRealtime();
+        final VisionConfig config;
+        final VisionProvider client;
+        Work(int r,String h,VisionConfig c){request=r;hash=h;config=c;client=c.create();}
+    }
+    private VisionController(Context c){context=c;reload();}
+    public void attach(HUDConnectivityService s){service=s;}
+    public void observe(Listener l){listener=l;if(l!=null)l.status(state);}
+    public void reload(){try{config=VisionConfig.load(context);enabled=config.enabled;status(configurationSummary());}catch(IOException e){enabled=false;status("Local Vision configuration is invalid.");}}
+    public String configurationSummary(){VisionConfig c=config;return c==null?"No valid local configuration.":"Provider: "+c.provider+" · Model: "+c.model+"\nKey: "+(c.key.length()>0?"configured":"missing")+" · Analysis: "+(enabled?"enabled":"disabled");}
+    private void status(final String text){state=text;ui.post(new Runnable(){public void run(){Listener l=listener;if(l!=null)l.status(text);}});}
+
+    /** Called only from the existing RFCOMM FILE receive path, before legacy public broadcasts. */
+    public void receive(final ReconMessage message){
+        if(!ReconMessage.PHOTO.equals(message.action))return;
+        final Work w;
+        synchronized(this){
+            if(requests.isCancelled(message.request)){Log.i("Snow3Vision","request="+message.request+" status=cancelledBeforeProcessing");return;}
+            if(requests.contains(message.request,message.info))return;
+            if(active!=null){send(message.request,message.info,"error","Another photo is processing.",0);return;}
+            if(!message.info.matches("[a-f0-9]{64}")){send(message.request,message.info,"error","Photo checksum missing.",0);return;}
+            VisionConfig c=config;
+            if(c==null){send(message.request,message.info,"error","Load a valid local API configuration in Snow3 Vision.",0);return;}
+            requests.remember(message.request,message.info);
+            w=new Work(message.request,message.info,c);active=w;
+        }
+        ui.postDelayed(new Runnable(){public void run(){timeout(w);}},65000);
+        worker.execute(new Runnable(){public void run(){process(w,message);}});
+    }
+    private void process(Work w,ReconMessage message){
+        byte[] jpeg=null;
+        try{
+            jpeg=ReconMessage.gunzip(message.data,ReconMessage.MAX_JPEG);
+            if(jpeg.length<4||(jpeg[0]&255)!=255||(jpeg[1]&255)!=216||!w.hash.equals(ReconMessage.sha256(jpeg)))throw new IOException("JPEG integrity check failed.");
+            BitmapFactory.Options options=new BitmapFactory.Options();options.inJustDecodeBounds=true;
+            BitmapFactory.decodeByteArray(jpeg,0,jpeg.length,options);
+            if(options.outWidth<=0||options.outHeight<=0||options.outWidth>2560||options.outHeight>1920)throw new IOException("Unsupported JPEG dimensions.");
+            if(!isActive(w))return;
+            send(w.request,w.hash,"received","",jpeg.length);
+            Log.i("Snow3Vision","request="+w.request+" jpegBytes="+jpeg.length+" sha256="+w.hash+" size="+options.outWidth+"x"+options.outHeight);
+            status("JPEG verified: "+jpeg.length+" bytes, "+options.outWidth+" × "+options.outHeight+". Processing…");
+            if(!enabled)throw new IOException("Vision disabled. Enable analysis in local configuration and reload Snow3 Vision.");
+            String credential=w.config.key, selected=w.config.model;
+            if(credential.length()==0)throw new IOException("Configure the API key in private local Snow3 Vision configuration.");
+            Log.i("Snow3Vision","request="+w.request+" provider="+w.config.provider+" model="+selected+" apiAttempt=1");
+            String answer=w.client.describe(jpeg,credential,selected);
+            finish(w,"result",answer,jpeg.length);
+        }catch(Exception e){
+            Log.w("Snow3Vision","analysisFailure="+e.getClass().getSimpleName()+" cause="+(e.getCause()==null?"none":e.getCause().getClass().getSimpleName()));
+            String messageText=e instanceof IOException?e.getMessage():"Photo analysis failed. Check Snow3 Vision configuration.";
+            // Network exception messages can include URLs/headers. Only controlled errors leave the module.
+            if(!(e instanceof IOException)||messageText==null||!(messageText.startsWith("OpenAI ")||messageText.startsWith("Gemini ")||messageText.startsWith("Vision ")||messageText.startsWith("Configure ")||messageText.startsWith("JPEG ")||messageText.startsWith("Unsupported ")||messageText.startsWith("Invalid local ")))
+                messageText="Photo analysis failed or network unavailable. Retry capture manually.";
+            finish(w,"error",messageText==null?"Analysis failed.":messageText,0);
+        }finally{if(jpeg!=null)java.util.Arrays.fill(jpeg,(byte)0);}
+    }
+    private synchronized boolean isActive(Work w){return active==w;}
+    private void finish(Work w,String type,String text,int bytes){
+        synchronized(this){if(active!=w)return;active=null;}
+        send(w.request,w.hash,type,text,bytes);status(("result".equals(type)?"Result: ":"Error: ")+text);
+        Log.i("Snow3Vision","request="+w.request+" status="+type+" elapsedMs="+(SystemClock.elapsedRealtime()-w.start));
+    }
+    private void timeout(Work w){if(isActive(w)){w.client.cancel();finish(w,"error","Analysis timed out. Retry capture.",0);}}
+    public void cancel(int request){Work w; synchronized(this){w=active;if(request!=-1)requests.cancel(request);else if(w!=null)requests.cancel(w.request);}if(w!=null&&(request==w.request||request==-1)){w.client.cancel();finish(w,"error","Cancelled.",0);}}
+    public void disable(){enabled=false;cancel(-1);status("Vision disabled.");}
+    public void clear(){disable();context.deleteFile(VisionConfig.FILE);reload();status("Private API configuration deleted; Vision disabled.");}
+    private void send(final int request,final String sha,final String status,final String text,final int bytes){
+        ui.post(new Runnable(){public void run(){
+            HUDConnectivityService target=service;
+            if(target==null)return;
+            try{
+                JSONObject body=new JSONObject().put("status",status).put("sha256",sha).put("bytes",bytes).put("text",text);
+                HUDConnectivityMessage m=new HUDConnectivityMessage(request,ReconMessage.RESULT,"com.recom3.snow3.vision","",body.toString().getBytes("UTF-8"));
+                target.push(m,HUDConnectivityService.Channel.OBJECT_CHANNEL);
+            }catch(Exception e){Log.w("Snow3Vision","Result delivery failed");}
+        }});
+    }
+}
