+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=27,constants=BuildConfig.class,application=Application.class,manifest=Config.NONE)
+public class CaptureLaunchTest {
+    private Intent view(String uri){return new Intent(Intent.ACTION_VIEW,Uri.parse(uri));}
+    @Test public void acceptsExactCaptureLink(){assertTrue(CaptureLaunch.matches(view("recom3://vision/capture")));}
+    @Test public void acceptsOnlyMappedInventoryId(){
+        assertTrue(CaptureLaunch.matches(new Intent(Intent.ACTION_VIEW).putExtra("feature","jet_camera")));
+        assertFalse(CaptureLaunch.matches(new Intent(Intent.ACTION_VIEW).putExtra("feature","camera")));
+        assertFalse(CaptureLaunch.matches(new Intent(Intent.ACTION_VIEW)));
+    }
+    @Test public void openingAppNeverCaptures(){
+        assertFalse(CaptureLaunch.matches(null));assertFalse(CaptureLaunch.matches(new Intent(Intent.ACTION_MAIN)));
+        assertFalse(CaptureLaunch.matches(new Intent(Intent.ACTION_SEND).setData(Uri.parse(CaptureLaunch.URI))));
+    }
+    @Test public void rejectsOtherRoutesAndParameterOverrides(){
+        String[] bad={"https://vision/capture","recom3://other/capture","recom3://vision/","recom3://vision/capture/","recom3://vision/capture?count=2","recom3://vision/capture#extra","recom3://user@vision/capture","recom3://vision:123/capture"};
