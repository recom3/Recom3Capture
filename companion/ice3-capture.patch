+package com.recom3.snow3.vision;
+import android.app.*;
+import android.content.*;
+import android.os.*;
+import com.recom3.snow3.mobilesdk.HUDConnectivityService;
+import com.recom3.jetandroid.services.EngageHudConnectivityService;
+
+/** User-started foreground session preserves Bluetooth/cloud access with the phone locked. */
+public final class VisionSessionService extends Service {
+    private boolean bound;
+    private final ServiceConnection connection=new ServiceConnection(){
+        public void onServiceConnected(ComponentName name,IBinder binder){
+            VisionController.get(VisionSessionService.this).attach(((HUDConnectivityService.LocalBinder)binder).getService());
+        }
+        public void onServiceDisconnected(ComponentName name){VisionController.get(VisionSessionService.this).attach(null);}
+    };
+    public void onCreate(){
+        super.onCreate();String channel="snow3_jet_vision";
+        if(Build.VERSION.SDK_INT>=26){NotificationManager nm=(NotificationManager)getSystemService(NOTIFICATION_SERVICE);nm.createNotificationChannel(new NotificationChannel(channel,"Jet Vision session",NotificationManager.IMPORTANCE_LOW));}
+        Intent view=new Intent(this,VisionActivity.class);
+        PendingIntent tap=PendingIntent.getActivity(this,8607,view,PendingIntent.FLAG_UPDATE_CURRENT|PendingIntent.FLAG_IMMUTABLE);
+        Notification.Builder n=Build.VERSION.SDK_INT>=26?new Notification.Builder(this,channel):new Notification.Builder(this);
+        startForeground(8607,n.setSmallIcon(android.R.drawable.ic_menu_camera).setContentTitle("Snow3 Jet Vision active")
+            .setContentText("Bluetooth camera analysis ready. Tap to view or stop.").setContentIntent(tap).setOngoing(true).build());
+        bound=bindService(new Intent(this,EngageHudConnectivityService.class),connection,Context.BIND_AUTO_CREATE);
+    }
+    public int onStartCommand(Intent i,int flags,int id){return START_NOT_STICKY;}
+    public IBinder onBind(Intent i){return null;}
+    public void onDestroy(){VisionController.get(this).disable();if(bound)unbindService(connection);stopForeground(true);super.onDestroy();}
+}
