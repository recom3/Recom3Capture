+import android.view.*;
+import android.widget.*;
+import com.recom3.snow3.mobilesdk.HUDConnectivityService;
+import com.recom3.jetandroid.services.EngageHudConnectivityService;
+import java.util.*;
+/** Separate Snow3 entry. Credentials are loaded only from a private local file. */
+public final class VisionActivity extends Activity implements VisionController.Listener{
+    private TextView state,config;
+    private Spinner peers;
+    private final List<BluetoothDevice> devices=new ArrayList<BluetoothDevice>();
+    private HUDConnectivityService service;
+    private boolean bound;
+    private VisionController controller;
+    private final ServiceConnection connection=new ServiceConnection(){
+        public void onServiceConnected(ComponentName name,IBinder binder){service=((HUDConnectivityService.LocalBinder)binder).getService();controller.attach(service);}
