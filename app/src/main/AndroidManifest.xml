<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.recom3.capture" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="16" android:targetSdkVersion="16" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application android:debuggable="true" android:label="Recom3 Capture" android:allowBackup="false" android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen">
        <activity android:name=".CaptureActivity" android:screenOrientation="landscape" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    <service android:name=".CaptureService" android:exported="false" /></application>
</manifest>
